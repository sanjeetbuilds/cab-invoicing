# Copy this file to .env.local and fill in the values.
# Get these from your Supabase project: Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — used in Milestone 6 for PDF extraction.
# ANTHROPIC_API_KEY=sk-ant-...

# Required to actually send the waitlist notification email (to
# hello@taximunshi.com) and any other transactional email. Without these,
# sends are skipped and logged to the server console instead of failing.
# Sign up at https://resend.com, verify a sending domain, create an API key.
# RESEND_API_KEY=re_...
# EMAIL_FROM=notifications@taximunshi.com
